# El agente de sesión del taller: ejecuta el código del alumno en el robot.
#
#   sudo cp atriz-agente.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now atriz-agente
#
# 🔴🔴 NO ESTÁ PROBADA. Escrita desde el PC el 2026-08-14, sin robot.

[Unit]
Description=Atriz · agente de sesión del taller (ejecuta el código del alumno)
Documentation=https://github.com/Bura-hub/Atriz_migracion_ros2
# El agente habla con rosbridge para comprobar el efecto, y el código del alumno
# necesita el grafo ROS levantado. Sin el driver no tiene con qué trabajar.
After=network-online.target atriz-robot.service
Wants=network-online.target
# ⚠️ `PartOf=` tiene un interplay MEDIDO con el vigía de DDS (evidencia 113):
#    cuando el vigía cura un robot mudo reinicia atriz-robot, y `PartOf=`
#    propaga ese reinicio AQUÍ — la ejecución del alumno muere con los cuatro
#    peldaños y el aviso «el agente se reinicia». Es lo correcto (su sesión ROS
#    estaba rota igual), pero tiene que estar ESCRITO: un programa que muere
#    «solo» sin esta nota se buscaría en el sitio equivocado.
PartOf=atriz-robot.service

[Service]
Type=simple
# 🔴 Como `sphero`, NO como root. Es lo que hace que el programa del alumno tenga
#    exactamente los mismos permisos que si lo lanzara por SSH — ni más ni menos.
#    Y por eso hay que quitar `~/.git-credentials` del robot: el código del
#    alumno puede leer lo que `sphero` lea.
User=sphero
Group=sphero
# `dialout`: mismo alcance que una sesión SSH de sphero (los puertos serie).
# 📝 Aquí ponía también `video` y se quitó en la auditoría del 2026-08-14: el
#    robot no tiene cámara (decisión del usuario) y un grupo de más es alcance
#    de más sin motivo escrito.
SupplementaryGroups=dialout

# ═══════════════════════════════════════════════════════════════════════════
# 🔴🔴 `RuntimeDirectoryPreserve=yes` NO ES OPCIONAL, Y AQUÍ ESTÁ EL PORQUÉ
# ═══════════════════════════════════════════════════════════════════════════
# `atriz-robot.service` declara este MISMO `RuntimeDirectory=atriz`, y dentro
# vive la marca del vigía de DDS que garantiza «una sola cura por arranque».
#
# Sin el `Preserve`, systemd **borra /run/atriz al parar esta unidad** — y con él
# esa marca. El vigía volvería a creerse con derecho a reiniciar el stack, y el
# síntoma sería un robot que se reinicia solo más de una vez por arranque, en
# mitad de una clase, sin que nada apunte al agente.
#
# Es un fallo CRUZADO entre dos unidades: `systemd-analyze verify` no lo ve, y
# leer cualquiera de las dos por separado tampoco.
RuntimeDirectory=atriz
RuntimeDirectoryPreserve=yes

ExecStart=/usr/local/bin/atriz-agente.sh

# ⚠️ `SIGINT` y no `SIGTERM`: el agente aplica sus cuatro peldaños al hijo antes
#    de irse, y el primero de esos peldaños es el Ctrl-C que `atriz.py` captura
#    para parar el robot y apagar el barrido. Un reinicio del agente que deje un
#    guion conduciendo es peor que el propio reinicio.
#    📝 Esa promesa la cumple `apagar_ordenado()` de agente_sesion.py — añadido
#    en la auditoría del 2026-08-14: hasta entonces la unidad lo prometía y el
#    código no lo tenía (el SIGINT era un KeyboardInterrupt a mitad de bucle).
KillSignal=SIGINT
# `mixed`: la señal SOLO al proceso principal — es quien orquesta los peldaños
# del hijo. Con el `control-group` por defecto, el hijo recibiría el SIGINT de
# systemd Y el del agente, y un doble Ctrl-C es justo el camino que atriz.py
# tuvo que endurecer una vez. El SIGKILL final del timeout sí va a todos.
KillMode=mixed
# 45 s: los cuatro peldaños del hijo (10 + 5 + margen) caben dentro.
TimeoutStopSec=45

Restart=always
RestartSec=5

# El agente no necesita privilegios de nada.
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
