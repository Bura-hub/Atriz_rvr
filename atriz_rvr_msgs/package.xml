<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://relaxng.org/ns/structure/1.0"?>
<package format="3">
  <name>atriz_rvr_msgs</name>
  <version>1.0.0</version>
  <description>
    Mensajes y servicios del robot Sphero RVR para el laboratorio remoto Atriz.
    Portado de catkin (ROS 1 Noetic) a ament_cmake + rosidl (ROS 2 Jazzy) el 2026-07-30.
  </description>

  <maintainer email="atriz@udenar.edu.co">Atriz Team - Universidad de Nariño</maintainer>
  <license>MIT</license>

  <url type="repository">https://github.com/Bura-hub/Atriz_rvr</url>
  <url type="bugtracker">https://github.com/Bura-hub/Atriz_rvr/issues</url>
  <author email="atriz@udenar.edu.co">Atriz Team</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Generación de interfaces. En ROS 1 esto era message_generation +
       message_runtime; en ROS 2 es rosidl_default_generators (build) y
       rosidl_default_runtime (exec), y hace falta pertenecer al grupo
       rosidl_interface_packages. -->
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <!-- Tipos usados por las interfaces:
         std_msgs/Header     -> MoveToPose, MoveToPosAndYaw, SetPosAndYaw
         geometry_msgs/Pose  -> MoveToPose
         geometry_msgs/Point -> MoveToPosAndYaw, SetPosAndYaw -->
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
