<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://relaxng.org/ns/structure/1.0"?>
<package format="3">
  <name>atriz_rvr_description</name>
  <version>1.0.0</version>
  <description>
    Descripción URDF/xacro del Sphero RVR para el laboratorio remoto Atriz.
    Creado el 2026-07-30 (Fase 3 del plan). Antes de esto el proyecto NO TENÍA
    ningún URDF, y el árbol TF estaba partido en dos frames inconexos
    (odom->rvr_base_link por un lado, base_link->laser por otro), lo que hacía
    imposible SLAM y Nav2.
  </description>

  <maintainer email="atriz@udenar.edu.co">Atriz Team - Universidad de Nariño</maintainer>
  <license>MIT</license>

  <url type="repository">https://github.com/Bura-hub/Atriz_rvr</url>
  <author email="atriz@udenar.edu.co">Atriz Team</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- xacro NO viene en ros-jazzy-ros-base: hay que instalarlo aparte
       (sudo apt install ros-jazzy-xacro). Comprobado el 2026-07-30.
       robot_state_publisher y tf2_tools SÍ vienen en ros-base. -->
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
